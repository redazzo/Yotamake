{
  "extraKnownMarketplaces": {
    "yotamake": {
      "source": {
        "source": "github",
        "repo": "redazzo/Yotamake"
      }
    }
  },
  "enabledPlugins": {
    "yotamake@yotamake": true
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(scripts/check:*)",
      "Bash(node scripts/docs/lint-docs.mjs:*)",
      "Bash(node scripts/docs/generate-records-index.mjs:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git switch:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git tag:*)",
      "Bash(git switch -f:*)",
      "Bash(git switch --force:*)",
      "Bash(git switch --discard-changes:*)",
      "Bash(git switch -C:*)",
      "Bash(git switch --force-create:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/yotamake/set-hooks-path.sh\"; [ -f \"$f\" ] && bash \"$f\" \"$CLAUDE_PROJECT_DIR\"; exit 0"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/yotamake/session-context.sh\"; [ -f \"$f\" ] && bash \"$f\" \"$CLAUDE_PROJECT_DIR\"; exit 0"
          }
        ]
      }
    ]
  }
}
