#!/usr/bin/env bash
# The one check entry point. Claude's skills, the pre-commit hook and CI all run
# this, so a change passes the same gate whoever makes it.
#
#   scripts/check          full checks for what changed since the main branch, plus
#                          uncommitted work (Claude runs this before proposing a commit)
#   scripts/check --staged fast checks for what is staged (the pre-commit hook uses this)
#   scripts/check --all    every check, whatever changed (CI uses this)
#
# Prints one PASS/FAIL line per check, and the tail of a failing check's output.
# Exit 0 when everything passes.
#
# This file belongs to the project: the harness installer never overwrites it.
# This repository installs its own harness (./plugin/install.sh .), so the plugin's
# eval cases are left out on purpose: they cost money. See CLAUDE.md, Checks.

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 2

mode=${1:-changed}

# The main branch: CHECK_BASE, else the "Main branch" line in CLAUDE.md (the same
# line the plugin's main-branch hook reads), else main or master.
main_branches() {
    if [[ -n "${CHECK_BASE:-}" ]]; then echo "$CHECK_BASE"; return; fi
    local m
    m=$(sed -n 's/^[-*][[:space:]]*\*\*Main branch:\*\*[[:space:]]*`\([^`]*\)`.*/\1/p' CLAUDE.md 2>/dev/null | head -n1)
    if [[ -n "$m" ]]; then echo "$m"; else printf '%s\n' main master; fi
}

case "$mode" in
    --all) changed="" ;;
    --staged) changed=$(git diff --cached --name-only) ;;
    changed)
        base=""
        for b in $(main_branches); do
            for ref in "$b" "origin/$b"; do
                base=$(git merge-base HEAD "$ref" 2>/dev/null) && break 2
            done
        done
        if [[ -z "$base" ]]; then
            # Without a base the changed files are unknown, so check everything.
            echo "note: no merge base with the main branch ($(main_branches | paste -sd/ -)); running every check. Set CHECK_BASE to override." >&2
            mode=--all
            changed=""
        else
            changed=$( { git diff --name-only "$base" 2>/dev/null; git ls-files --others --exclude-standard; } | sort -u)
        fi ;;
    *) echo "usage: scripts/check [--staged|--all]" >&2; exit 2 ;;
esac

failed=0
ran=0
run() {
    local name=$1; shift
    ran=$((ran + 1))
    local out
    if out=$("$@" 2>&1); then
        echo "PASS  $name"
    else
        echo "FAIL  $name"
        tail -n 40 <<<"$out" | sed 's/^/      /'
        failed=1
    fi
}
# touches <regex>: true when a changed path matches, or always under --all.
touches() { [[ "$mode" == --all ]] || grep -qE "$1" <<<"$changed"; }
# full: true except in the pre-commit hook. Put slow checks behind it.
full() { [[ "$mode" != --staged ]]; }

# --- Fast: every run, including the pre-commit hook ---------------------------
run syntax bash -c '
    git ls-files -z -co --exclude-standard "*.sh" scripts/check .githooks/pre-commit \
        plugin/template/scripts/check plugin/template/.githooks/pre-commit | xargs -0 -n1 bash -n &&
    git ls-files -z -co --exclude-standard "*.mjs" | xargs -0 -n1 node --check'

# Design gate: the rules in CLAUDE.md about keeping this repository in step
# (versions, section names, Architecture labels, the eval list, harness copies).
run consistency node scripts/consistency.mjs

run docs node scripts/docs/lint-docs.mjs

# The landing site's links (its skills cards are a consistency rule).
run site node scripts/check-site.mjs

touches '^plugin/hooks/|^plugin/template/\.claude/yotamake/|^scripts/test-hooks' &&
    run hooks bash scripts/test-hooks.sh

# --- Full: not in the pre-commit hook -----------------------------------------
# A project-owned template file changed on this branch: it needs an upgrades.md entry.
upgrade_entries() { node scripts/consistency.mjs upgrades <<<"$changed"; }
full && [[ "$mode" == changed ]] && run upgrades upgrade_entries

validate() { claude plugin validate plugin --strict && claude plugin validate . --strict; }
full && run validate validate

full && touches '^plugin/(install\.sh|template/|evals/_fixture/|\.claude-plugin/)|^scripts/test-install' &&
    run install bash scripts/test-install.sh

# Not a check: names the eval cases that cover what changed (README.md, Evals). They cost
# money, so they stay out of the gate.
full && [[ "$mode" == changed ]] && touches '^plugin/' &&
    node scripts/consistency.mjs evals-for <<<"$changed"

# Not a check: names site pages that may need updating (CLAUDE.md, "Site pages").
full && [[ "$mode" == changed ]] && touches '^plugin/(skills/|hooks/|install\.sh|template/)' &&
    node scripts/consistency.mjs pages-for <<<"$changed"

# A passing run outside the pre-commit hook leaves a stamp in the git directory. The
# plugin's Stop hook reads it: Claude may not end a turn with code edited after the last
# pass. A run with no checks leaves none. Keep these lines when you edit the file.
if [[ $ran -eq 0 ]]; then
    echo "note: no checks ran, so no pass stamp was written. Add checks to scripts/check (/yotamake:setup finds them)." >&2
elif [[ $failed -eq 0 && "$mode" != --staged ]]; then
    touch "$(git rev-parse --git-path yotamake-check-passed)"
fi
exit $failed
