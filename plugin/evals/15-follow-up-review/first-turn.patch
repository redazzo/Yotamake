 # Greeting
 
 `greet(name)` in `src/greet.js` returns `Hello, <name>.` — the name, ending with a full stop.
+The name is capitalised word by word with `titleCase` from `src/text.js`, so
+`greet("ada LOVELACE")` returns `Hello, Ada Lovelace.`.
diff --git a/src/greet.js b/src/greet.js
index 8463031..cf7c87a 100644
--- a/src/greet.js
+++ b/src/greet.js
@@ -1,4 +1,6 @@
+import { titleCase } from './text.js';
+
 // Returns the greeting shown to a user.
 export function greet(name) {
-  return `Hello, ${name}.`;
+  return `Hello, ${titleCase(name)}.`;
 }
