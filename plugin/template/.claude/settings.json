{
  "extraKnownMarketplaces": {
    "yotamake": {
      "source": {
        "source": "github",
        "repo": "redazzo/Yotamake"
      }
    }
  },
  "enabledPlugins": {
    "yotamake@yotamake": true
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(scripts/check:*)",
      "Bash(node scripts/docs/lint-docs.mjs:*)",
      "Bash(node scripts/docs/generate-records-index.mjs:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git tag:*)",
      "Bash(git switch -f:*)",
      "Bash(git switch --force:*)",
      "Bash(git switch --discard-changes:*)",
      "Bash(git switch -C:*)",
      "Bash(git switch --force-create:*)"
    ]
  }
}
